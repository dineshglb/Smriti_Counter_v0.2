<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.SmritiCounter">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".BinduActivity"
            android:exported="false" />

        <receiver
            android:name=".TrafficControlReceiver"
            android:exported="false" />

        <!-- 2x2 Dark & Light -->
        <receiver
            android:name=".SmritiWidget2x2Dark"
            android:label="@string/widget_2x2_dark"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/smriti_widget_2x2_dark_info" />
        </receiver>

        <receiver
            android:name=".SmritiWidget2x2Light"
            android:label="@string/widget_2x2_light"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/smriti_widget_2x2_light_info" />
        </receiver>

        <!-- 4x4 Dark & Light -->
        <receiver
            android:name=".SmritiWidget4x4Dark"
            android:label="@string/widget_4x4_dark"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/smriti_widget_4x4_dark_info" />
        </receiver>

        <receiver
            android:name=".SmritiWidget4x4Light"
            android:label="@string/widget_4x4_light"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/smriti_widget_4x4_light_info" />
        </receiver>

        <!-- 6x6 Dark & Light -->
        <receiver
            android:name=".SmritiWidget6x6Dark"
            android:label="@string/widget_6x6_dark"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/smriti_widget_6x6_dark_info" />
        </receiver>

        <receiver
            android:name=".SmritiWidget6x6Light"
            android:label="@string/widget_6x6_light"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/smriti_widget_6x6_light_info" />
        </receiver>

    </application>
</manifest>
